<clickhouse>
  <!-- Docs: <https://clickhouse.com/docs/operations/settings/settings_users/> -->
  <profiles>
    <writer>
      <readonly>0</readonly>
      <allow_ddl>0</allow_ddl>
      <allow_introspection_functions>0</allow_introspection_functions>
      <allow_databases>default,kafka_internal</allow_databases>
    </writer>
    <readonly>
      <readonly>1</readonly>
      <allow_ddl>0</allow_ddl>
      <allow_introspection_functions>0</allow_introspection_functions>
      <allow_databases>default,kafka_internal</allow_databases>
    </readonly>
  </profiles>
  <users>
    <!-- Keep default user enabled for now (no enforcement yet). -->
    <default>
      <profile>default</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <quota>default</quota>
    </default>

    <admin>
      <profile>default</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <password from_env="CLICKHOUSE_PASSWORD"/>
      <quota>default</quota>
      <access_management>0</access_management>
    </admin>

    <writer>
      <profile>writer</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <password from_env="CLICKHOUSE_WRITER_PASSWORD"/>
      <quota>default</quota>
    </writer>

    <readonly>
      <profile>readonly</profile>
      <networks>
        <ip>::/0</ip>
      </networks>
      <password from_env="CLICKHOUSE_READONLY_PASSWORD"/>
      <quota>default</quota>
    </readonly>
  </users>
</clickhouse>
