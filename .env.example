# Non-secret defaults for the Kafka to ClickHouse local stack

# REQUIRED CLUSTER SETTINGS
# Kafka KRaft cluster identity (generate with: docker run --rm confluentinc/cp-kafka:7.7.7 kafka-storage.sh random-uuid)
CLUSTER_ID=8Zt6o8hOSRuY0rFBLv0BTA

# ClickHouse credentials (local only; change for your env)
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=clickhouse

# Kafka log level (set to INFO temporarily to debug)
KAFKA_LOG4J_ROOT_LOGLEVEL=WARN

# Kafka SASL/PLAIN (local only; align with configs/kafka/secrets/broker_jaas.conf)
KAFKA_BROKER_SASL_USERNAME=broker
KAFKA_BROKER_SASL_PASSWORD=change_me
SCHEMA_REGISTRY_SASL_USERNAME=schema_registry
SCHEMA_REGISTRY_SASL_PASSWORD=change_me
KAFKA_CONNECT_SASL_USERNAME=kafka_connect
KAFKA_CONNECT_SASL_PASSWORD=change_me
KAFKA_CLIENT_SASL_USERNAME=client
KAFKA_CLIENT_SASL_PASSWORD=change_me

# SMOKE TEST VARIABLES
SCHEMA_REGISTRY_URL=http://localhost:8081
CONNECT_URL=http://localhost:8083
CLICKHOUSE_HTTP=http://localhost:18123
CLICKHOUSE_NODE1_HTTP=http://localhost:8123
CLICKHOUSE_NODE2_HTTP=http://localhost:8124
CONNECTOR_CONFIG=configs/connect/clickhouse-sink.json
CONNECTOR_NAME=clickhouse-sink
TABLE_DDL=sql/ddl/clickhouse_kafka_sink.sql
TOPIC=kafka-events
TABLE=kafka_events
SCHEMA_SUBJECT=kafka-events-value
BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092
BOOTSTRAP_SERVERS_INTERNAL=kafka-broker-1:9093,kafka-broker-2:9093,kafka-broker-3:9093
GROUP_ID=smoke-avro-consumer
MAX_MESSAGES=5
MESSAGE_ID=42
LIMIT=10
AVRO_SMOKE_TOPIC=smoke-avro
AVRO_SMOKE_SUBJECT=smoke-avro-value
KAFKA_SMOKE_TOPIC=smoke-kafka
SCHEMA_REGISTRY_URL_INTERNAL=http://schema-registry:8081
