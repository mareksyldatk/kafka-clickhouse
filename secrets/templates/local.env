# Local secrets for the Kafka + ClickHouse stack (do not commit real values).
# Copy to secrets/local.env and update the values for your environment.

# ClickHouse passwords
CLICKHOUSE_ADMIN_PASSWORD=change_me
CLICKHOUSE_WRITER_PASSWORD=change_me
CLICKHOUSE_READER_PASSWORD=change_me

# Kafka SASL/PLAIN passwords
KAFKA_BROKER_SASL_PASSWORD=change_me
SCHEMA_REGISTRY_SASL_PASSWORD=change_me
KAFKA_CONNECT_SASL_PASSWORD=change_me
KAFKA_CLIENT_SASL_PASSWORD=change_me
