# Local environment files (non-secret examples only should be committed)
.env
.env.local
.env.*.local

# Local secrets (templates are tracked)
secrets/*
!secrets/templates/
!secrets/templates/**

# OS/editor cruft
.DS_Store
.idea/

# Logs and caches
*.log
__pycache__/

# Local data mounts
data/

# ClickHouse entrypoint-generated user file (local only)
configs/clickhouse/users.d/default-user.xml

# Ensure contributor guide is tracked even if globally ignored
!AGENTS.md
